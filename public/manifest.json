{
  "manifest_version": 3,
  "name": "InstaFinder",
  "version": "0.1.0",
  "description": "Collect Instagram followers, following, commenters and likers, then review profiles to find the person you're looking for.",
  "permissions": ["cookies", "unlimitedStorage", "storage", "scripting"],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://i.instagram.com/*",
    "https://*.cdninstagram.com/*",
    "https://*.fbcdn.net/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Open InstaFinder",
    "default_icon": {
      "32": "icons/32.png"
    }
  },
  "options_page": "app.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' https: data: blob:; connect-src 'self' https://www.instagram.com https://i.instagram.com https://*.cdninstagram.com https://*.fbcdn.net"
  },
  "icons": {
    "32": "icons/32.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["page-observer.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["page-driver.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
